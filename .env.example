# Bitrix24 inbound webhook: Developer resources -> Other -> Inbound webhook.
# Grant only the scopes you need (crm, task, user). This URL is a secret.
BITRIX24_WEBHOOK_URL=https://your-portal.bitrix24.kz/rest/1/your_webhook_token/

# Read-only by default. Set to false to enable create/update tools.
BITRIX24_READ_ONLY=true

# Exposes a generic call_method tool that can call ANY REST method. Keep off.
BITRIX24_ALLOW_RAW_CALLS=false

# Transport: stdio (Claude Desktop, Claude Code, Cursor) or http (Docker, remote agents).
MCP_TRANSPORT=http
MCP_PORT=8000

# Required for http: clients must send "Authorization: Bearer <token>".
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_AUTH_TOKEN=

# Optional: comma-separated Host headers allowed (DNS rebinding protection),
# e.g. mcp.example.kz when served behind a reverse proxy.
MCP_ALLOWED_HOSTS=

LOG_LEVEL=INFO
